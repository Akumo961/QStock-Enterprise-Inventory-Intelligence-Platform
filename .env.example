# QStock environment configuration template
# Copy this file to .env and replace every CHANGE_ME value locally.
# NEVER commit .env or real credentials to Git.

# Application
APP_NAME=QStock
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database
# Local development:
# DATABASE_URL=postgresql://qr_admin:Kaido1234@localhost:5432/qr_inventory

# Docker:
DATABASE_URL=postgresql://qr_admin:Kaido1234@postgres:5432/qr_inventory

# Security
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial admin setup
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PHONE=

# Optional email configuration
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

# AI - OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=

# AI - Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ANSWER_MODEL=
OLLAMA_NUM_GPU=
OLLAMA_THINK=false

# AI tuning
AI_MAX_HISTORY_TURNS=3
AI_ANSWER_MAX_TOKENS=120
AI_ANSWER_NUM_CTX=4096
AI_CONTEXT_ROW_LIMIT=15
AI_SQL_MAX_TOKENS=300
AI_SQL_NUM_CTX=4096
AI_DETERMINISTIC_LIST_ANSWERS=true

# Ollama HTTP timeouts
OLLAMA_CONNECT_TIMEOUT=30
OLLAMA_READ_TIMEOUT=300
OLLAMA_WRITE_TIMEOUT=30
OLLAMA_POOL_TIMEOUT=30

# AI performance instrumentation
AI_METRICS_MAX_SAMPLES=1000
AI_PERFORMANCE_LOGGING=true
